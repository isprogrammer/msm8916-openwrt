diff --git a/arch/arm64/boot/dts/qcom/msm8916-ufi-voice.dtsi b/arch/arm64/boot/dts/qcom/msm8916-ufi-voice.dtsi
new file mode 100644
index 0000000..69d66c7
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-ufi-voice.dtsi
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Call audio for the UFI sticks: the modem DSP (QDSP6) voice path is routed
+ * to the internal BT SCO link of WCNSS, and exposed to the host through the
+ * in-call record taps and the in-call playback port. No codec pins are used.
+ *
+ *   pcm0 MultiMedia1: capture (VOC_REC_DL/UL) or playback
+ *   pcm1 MultiMedia2: playback into the call (VOICE_PLAYBACK_TX) or capture
+ *   pcm2 CS-Voice:    hostless, open both directions to start the voice path
+ */
+
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/sound/qcom,q6voice.h>
+
+/ {
+	bt_sco_codec: bt-sco-codec {
+		compatible = "linux,bt-sco";
+		#sound-dai-cells = <1>;
+	};
+};
+
+&apr {
+	status = "okay";
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <0>;
+		direction = <Q6ASM_DAI_TX_RX>;
+	};
+	dai@1 {
+		reg = <1>;
+		direction = <Q6ASM_DAI_TX_RX>;
+	};
+};
+
+&sound {
+	compatible = "qcom,msm8916-qdsp6-sndcard";
+	model = "msm8916-voice";
+	status = "okay";
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		};
+	};
+
+	cs-voice-dai-link {
+		link-name = "CS-Voice";
+		cpu {
+			sound-dai = <&q6voicedai CS_VOICE>;
+		};
+	};
+
+	int-bt-sco-rx-dai-link {
+		link-name = "INT_BT_SCO_RX";
+		cpu {
+			sound-dai = <&q6afedai INT_BT_SCO_RX>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+		codec {
+			sound-dai = <&bt_sco_codec 0>;
+		};
+	};
+
+	int-bt-sco-tx-dai-link {
+		link-name = "INT_BT_SCO_TX";
+		cpu {
+			sound-dai = <&q6afedai INT_BT_SCO_TX>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+		codec {
+			sound-dai = <&bt_sco_codec 0>;
+		};
+	};
+
+	voice-record-rx-dai-link {
+		link-name = "VOICE_RECORD_RX";
+		cpu {
+			sound-dai = <&q6afedai VOICE_RECORD_RX>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+		codec {
+			sound-dai = <&bt_sco_codec 0>;
+		};
+	};
+
+	voice-record-tx-dai-link {
+		link-name = "VOICE_RECORD_TX";
+		cpu {
+			sound-dai = <&q6afedai VOICE_RECORD_TX>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+		codec {
+			sound-dai = <&bt_sco_codec 0>;
+		};
+	};
+
+	voice-playback-tx-dai-link {
+		link-name = "VOICE_PLAYBACK_TX";
+		cpu {
+			sound-dai = <&q6afedai VOICE_PLAYBACK_TX>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+		codec {
+			sound-dai = <&bt_sco_codec 0>;
+		};
+	};
+};
