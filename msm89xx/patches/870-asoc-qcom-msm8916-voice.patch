+} __packed;
+
 union afe_port_config {
+	struct afe_param_id_internal_bt_fm_cfg	int_bt_cfg;
+	struct afe_param_id_pseudo_port_cfg	pseudo_cfg;
 	struct afe_param_id_hdmi_multi_chan_audio_cfg hdmi_multi_ch;
 	struct afe_param_id_slimbus_cfg           slim_cfg;
 	struct afe_param_id_i2s_cfg	i2s_cfg;
@@ -547,6 +576,8 @@ struct q6afe_port {
 	int token;
 	int id;
 	int cfg_type;
+	/* Size of the port config payload, 0: whole union (as before) */
+	int cfg_size;
 	struct q6afe *afe;
 	struct kref refcount;
 	struct list_head node;
@@ -833,6 +864,16 @@ static struct afe_port_map port_maps[AFE_PORT_MAX] = {
 				RX_CODEC_DMA_RX_6, 1, 1},
 	[RX_CODEC_DMA_RX_7] = { AFE_PORT_ID_RX_CODEC_DMA_RX_7,
 				RX_CODEC_DMA_RX_7, 1, 1},
+	[INT_BT_SCO_RX] = { AFE_PORT_ID_INTERNAL_BT_SCO_RX,
+				INT_BT_SCO_RX, 1, 0},
+	[INT_BT_SCO_TX] = { AFE_PORT_ID_INTERNAL_BT_SCO_TX,
+				INT_BT_SCO_TX, 0, 0},
+	[VOICE_RECORD_RX] = { AFE_PORT_ID_VOICE_RECORD_RX,
+				VOICE_RECORD_RX, 0, 0},
+	[VOICE_RECORD_TX] = { AFE_PORT_ID_VOICE_RECORD_TX,
+				VOICE_RECORD_TX, 0, 0},
+	[VOICE_PLAYBACK_TX] = { AFE_PORT_ID_VOICE_PLAYBACK_TX,
+				VOICE_PLAYBACK_TX, 1, 0},
 };
 
 static void q6afe_port_free(struct kref *ref)
@@ -1476,6 +1517,48 @@ void q6afe_cdc_dma_port_prepare(struct q6afe_port *port,
 		dma_cfg->active_channels_mask = (1 << cfg->num_channels) - 1;
 }
 EXPORT_SYMBOL_GPL(q6afe_cdc_dma_port_prepare);
+
+/**
+ * q6afe_bt_port_prepare() - Prepare an internal BT SCO afe port.
+ *
+ * @port: Instance of afe port
+ * @cfg: rate/width/channels for the port
+ */
+void q6afe_bt_port_prepare(struct q6afe_port *port,
+			   struct q6afe_simple_cfg *cfg)
+{
+	struct afe_param_id_internal_bt_fm_cfg *bt = &port->port_cfg.int_bt_cfg;
+
+	bt->bt_fm_cfg_minor_version = AFE_API_VERSION_INTERNAL_BT_FM_CONFIG;
+	bt->num_channels = cfg->num_channels;
+	bt->bit_width = cfg->bit_width;
+	bt->sample_rate = cfg->sample_rate;
+	port->cfg_size = sizeof(*bt);
+}
