new file mode 100644
index 0000000..d1a763d
--- /dev/null
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -0,0 +1,445 @@
+// SPDX-License-Identifier: GPL-2.0
+// Copyright (c) 2012-2017, The Linux Foundation. All rights reserved.
+// Copyright (c) 2020, Stephan Gerhold
+
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include "q6afe.h"
+#include "q6cvp.h"
+#include "q6cvs.h"
+#include "q6mvm.h"
+#include "q6voice-common.h"
+
+struct q6voice_path_runtime {
+	struct q6voice_session *sessions[Q6VOICE_SERVICE_COUNT];
+	unsigned int started;
+};
+
+struct q6voice_path {
+	struct q6voice *v;
+
+	enum q6voice_path_type type;
+	int tx_port, rx_port;
+	int session;		/* enum q6voice_session_name */
+	int record;		/* Q6VOICE_RECORD_* wanted */
+	bool playback;		/* in-call playback wanted */
+	int record_on;		/* taps active in the DSP */
+	bool playback_on;
+	bool tx_mute;		/* mic muted (vocproc TX) wanted */
+	bool tx_mute_on;
+	/* Serialize access to voice path session */
+	struct mutex lock;
+	struct q6voice_path_runtime *runtime;
+};
+
+struct q6voice {
+	struct device *dev;
+	struct q6voice_path paths[Q6VOICE_PATH_COUNT];
+};
+
+static const char *q6voice_session_str(struct q6voice_path *p)
+{
+	return p->session == Q6VOICE_SESSION_VOLTE ? "default volte voice" :
+						     "default modem voice";
+}
+
+/* Bring the record taps and in-call playback in line with what is wanted. */
+static void q6voice_path_update_cvs(struct q6voice_path *p)
+{
+	struct device *dev = p->v->dev;
+	struct q6voice_session *cvs;
+	int ret;
+
+	if (!p->runtime || p->runtime->started != 3)
+		return;
+
+	cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+	if (!cvs && (p->record || p->playback)) {
+		cvs = q6cvs_session_create(p->type, q6voice_session_str(p));
+		if (IS_ERR(cvs)) {
+			dev_err(dev, "failed to create cvs session: %ld\n",
+				PTR_ERR(cvs));
+			return;
+		}
+		p->runtime->sessions[Q6VOICE_SERVICE_CVS] = cvs;
+	}
+	if (!cvs)
+		return;
+
+	if (p->record != p->record_on) {
+		/* The taps can only be changed by stopping the recording */
+		if (p->record_on) {
+			ret = q6cvs_record(cvs, false, false);
+			if (ret)
+				dev_err(dev, "failed to stop record: %d\n", ret);
+			p->record_on = 0;
+		}
+		if (p->record) {
+			ret = q6cvs_record(cvs, p->record & Q6VOICE_RECORD_RX,
+					   p->record & Q6VOICE_RECORD_TX);
+			if (ret)
+				dev_err(dev, "failed to start record: %d\n", ret);
+			else
+				p->record_on = p->record;
+		}
+	}
+
+	if (p->playback != p->playback_on) {
+		ret = q6cvs_playback(cvs, p->playback);
+		if (ret)
+			dev_err(dev, "failed to %s playback: %d\n",
+				p->playback ? "start" : "stop", ret);
+		else
+			p->playback_on = p->playback;
+	}
+}
+
+/* Bring the vocproc TX mute in line with what is wanted. */
+static void q6voice_path_update_mute(struct q6voice_path *p)
+{
+	struct q6voice_session *cvp;
+	int ret;
+
+	if (!p->runtime || p->runtime->started != 3)
+		return;
+
+	cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	if (!cvp || p->tx_mute == p->tx_mute_on)
+		return;
+
+	ret = q6cvp_mute(cvp, true, p->tx_mute);
+	if (ret)
+		dev_err(p->v->dev, "failed to %smute tx: %d\n",
+			p->tx_mute ? "" : "un", ret);
+	else
+		p->tx_mute_on = p->tx_mute;
+}
+
+static int q6voice_path_start(struct q6voice_path *p)
+{
+	struct device *dev = p->v->dev;
+	struct q6voice_session *mvm, *cvp;
+	int ret;
+
+	dev_dbg(dev, "start path %d\n", p->type);
+
+	mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	if (!mvm) {
+		mvm = q6mvm_session_create(p->type, q6voice_session_str(p));
+		if (IS_ERR(mvm))
+			return PTR_ERR(mvm);
+		p->runtime->sessions[Q6VOICE_SERVICE_MVM] = mvm;
+	}
+
+	cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	if (!cvp) {
+		cvp = q6cvp_session_create(p->type,
+					   q6afe_get_port_id(p->tx_port),
+					   q6afe_get_port_id(p->rx_port));
+		if (IS_ERR(cvp))
+			return PTR_ERR(cvp);
+		p->runtime->sessions[Q6VOICE_SERVICE_CVP] = cvp;
+	}
+
+	ret = q6cvp_enable(cvp, true);
+	if (ret) {
+		dev_err(dev, "failed to enable cvp: %d\n", ret);
+		goto cvp_err;
+	}
+
+	ret = q6mvm_attach(mvm, cvp, true);
+	if (ret) {
+		dev_err(dev, "failed to attach cvp to mvm: %d\n", ret);
+		goto attach_err;
+	}
+
+	ret = q6mvm_start(mvm, true);
+	if (ret) {
+		dev_err(dev, "failed to start voice: %d\n", ret);
+		goto start_err;
+	}
+
+	return ret;
+
+start_err:
+	q6mvm_start(mvm, false);
+attach_err:
+	q6mvm_attach(mvm, cvp, false);
+cvp_err:
+	q6cvp_enable(cvp, false);
+	return ret;
+}
+
+int q6voice_start(struct q6voice *v, enum q6voice_path_type path, bool capture)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	if (!p->runtime) {
+		p->runtime = kzalloc(sizeof(*p), GFP_KERNEL);
+		if (!p->runtime) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+
+	if (p->runtime->started & BIT(capture)) {
+		ret = -EALREADY;
+		goto out;
+	}
+
+	p->runtime->started |= BIT(capture);
+
+	/* FIXME: For now we only start if both RX/TX are active */
+	if (p->runtime->started != 3)
+		goto out;
+
+	ret = q6voice_path_start(p);
+	if (ret) {
+		p->runtime->started &= ~BIT(capture);
+		dev_err(v->dev, "failed to start path %d: %d\n", path, ret);
+		goto out;
+	}
+
+	q6voice_path_update_mute(p);
+	q6voice_path_update_cvs(p);
+
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_start);
+
+static void q6voice_path_stop(struct q6voice_path *p)
+{
+	struct device *dev = p->v->dev;
+	struct q6voice_session *mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	struct q6voice_session *cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	int ret;
+
+	dev_dbg(dev, "stop path %d\n", p->type);
+
+	if (p->runtime->sessions[Q6VOICE_SERVICE_CVS]) {
+		struct q6voice_session *cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+		if (p->playback_on)
+			q6cvs_playback(cvs, false);
+		if (p->record_on)
+			q6cvs_record(cvs, false, false);
+	}
+	p->playback_on = false;
+	p->record_on = 0;
+	p->tx_mute_on = false;
+
+	ret = q6mvm_start(mvm, false);
+	if (ret)
+		dev_err(dev, "failed to stop voice: %d\n", ret);
+
+	ret = q6mvm_attach(mvm, cvp, false);
+	if (ret)
+		dev_err(dev, "failed to detach cvp from mvm: %d\n", ret);
+
+	ret = q6cvp_enable(cvp, false);
+	if (ret)
+		dev_err(dev, "failed to disable cvp: %d\n", ret);
+}
+
+static void q6voice_path_destroy(struct q6voice_path *p)
+{
+	struct q6voice_path_runtime *runtime = p->runtime;
+	enum q6voice_service_type svc;
+
+	for (svc = 0; svc < Q6VOICE_SERVICE_COUNT; ++svc) {
+		if (runtime->sessions[svc])
+			q6voice_session_release(runtime->sessions[svc]);
+	}
+
+	p->runtime = NULL;
+	kfree(runtime);
+}
+
+int q6voice_stop(struct q6voice *v, enum q6voice_path_type path, bool capture)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	if (!p->runtime || !(p->runtime->started & BIT(capture)))
+		goto out;
+
+	if (p->runtime->started == 3)
+		q6voice_path_stop(p);
+
+	p->runtime->started &= ~BIT(capture);
+
+	if (p->runtime->started == 0)
+		q6voice_path_destroy(p);
+
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_stop);
+
+static void q6voice_free(void *data)
+{
+	struct q6voice *v = data;
+	enum q6voice_path_type path;
+
+	for (path = 0; path < Q6VOICE_PATH_COUNT; ++path) {
+		struct q6voice_path *p = &v->paths[path];
+
+		mutex_lock(&p->lock);
+		if (p->runtime) {
+			dev_warn(v->dev,
+				 "q6voice_remove() called while path %d is active\n",
+				 path);
+
+			if (p->runtime->started == 3)
+				q6voice_path_stop(p);
+			q6voice_path_destroy(p);
+		}
+		mutex_unlock(&p->lock);
+		mutex_destroy(&p->lock);
+	}
+}
+
+struct q6voice *q6voice_create(struct device *dev)
+{
+	struct q6voice *v;
+	enum q6voice_path_type path;
+	int ret;
+
+	v = devm_kzalloc(dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return ERR_PTR(-ENOMEM);
+
+	v->dev = dev;
+
+	for (path = 0; path < Q6VOICE_PATH_COUNT; ++path) {
+		struct q6voice_path *p = &v->paths[path];
+
+		p->v = v;
+		p->type = path;
+		mutex_init(&p->lock);
+	}
+
+	ret = devm_add_action(dev, q6voice_free, v);
+	if (ret)
+		return ERR_PTR(ret);
+
+	return v;
+}
+EXPORT_SYMBOL_GPL(q6voice_create);
+
+int q6voice_get_port(struct q6voice *v, enum q6voice_path_type path,
+		     bool capture)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	if (capture)
+		return p->tx_port;
+	else
+		return p->rx_port;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_port);
+
+void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
+		      bool capture, int index)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	if (capture)
+		p->tx_port = index;
+	else
+		p->rx_port = index;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_port);
+
+int q6voice_get_session(struct q6voice *v, enum q6voice_path_type path)
+{
+	return v->paths[path].session;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_session);
+
+int q6voice_set_session(struct q6voice *v, enum q6voice_path_type path,
+			int session)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	/* The session name is used when the path starts */
+	if (p->runtime && p->runtime->started)
+		ret = -EBUSY;
+	else
+		p->session = session;
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_session);
+
+int q6voice_get_record(struct q6voice *v, enum q6voice_path_type path)
+{
+	return v->paths[path].record;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_record);
+
+int q6voice_set_record(struct q6voice *v, enum q6voice_path_type path,
+		       int mask)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	mutex_lock(&p->lock);
+	p->record = mask & (Q6VOICE_RECORD_RX | Q6VOICE_RECORD_TX);
+	q6voice_path_update_cvs(p);
+	mutex_unlock(&p->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_record);
+
+int q6voice_get_playback(struct q6voice *v, enum q6voice_path_type path)
+{
+	return v->paths[path].playback;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_playback);
+
+int q6voice_set_playback(struct q6voice *v, enum q6voice_path_type path,
+			 bool state)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	mutex_lock(&p->lock);
+	p->playback = state;
+	q6voice_path_update_cvs(p);
+	mutex_unlock(&p->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_playback);
+
+int q6voice_get_tx_mute(struct q6voice *v, enum q6voice_path_type path)
+{
+	return v->paths[path].tx_mute;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_tx_mute);
+
+int q6voice_set_tx_mute(struct q6voice *v, enum q6voice_path_type path,
+			bool mute)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	mutex_lock(&p->lock);
+	p->tx_mute = mute;
+	q6voice_path_update_mute(p);
+	mutex_unlock(&p->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_tx_mute);
+
+MODULE_AUTHOR("Stephan Gerhold <stephan@gerhold.net>");
+MODULE_DESCRIPTION("Q6Voice driver");
+MODULE_LICENSE("GPL v2");
diff --git a/sound/soc/qcom/qdsp6/q6voice.h b/sound/soc/qcom/qdsp6/q6voice.h
