diff --git a/sound/soc/qcom/qdsp6/q6afe-dai.c b/sound/soc/qcom/qdsp6/q6afe-dai.c
index 7d9628c..63c1f4e 100644
--- a/sound/soc/qcom/qdsp6/q6afe-dai.c
+++ b/sound/soc/qcom/qdsp6/q6afe-dai.c
@@ -334,6 +334,20 @@ static int q6dma_hw_params(struct snd_pcm_substream *substream,
 
 	return 0;
 }
+static int q6simple_hw_params(struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params,
+			      struct snd_soc_dai *dai)
+{
+	struct q6afe_dai_data *dai_data = dev_get_drvdata(dai->dev);
+	struct q6afe_simple_cfg *cfg = &dai_data->port_config[dai->id].simple;
+
+	cfg->sample_rate = params_rate(params);
+	cfg->bit_width = 16;
+	cfg->num_channels = params_channels(params);
+
+	return 0;
+}
+
 static void q6afe_dai_shutdown(struct snd_pcm_substream *substream,
 				struct snd_soc_dai *dai)
 {
@@ -394,6 +408,17 @@ static int q6afe_dai_prepare(struct snd_pcm_substream *substream,
 		q6afe_cdc_dma_port_prepare(dai_data->port[dai->id],
 					   &dai_data->port_config[dai->id].dma_cfg);
 		break;
+	case INT_BT_SCO_RX:
+	case INT_BT_SCO_TX:
+		q6afe_bt_port_prepare(dai_data->port[dai->id],
+				      &dai_data->port_config[dai->id].simple);
+		break;
+	case VOICE_RECORD_RX:
+	case VOICE_RECORD_TX:
+	case VOICE_PLAYBACK_TX:
+		q6afe_pseudo_port_prepare(dai_data->port[dai->id],
+					  &dai_data->port_config[dai->id].simple);
+		break;
 	default:
 		return -EINVAL;
 	}
@@ -622,6 +647,11 @@ static const struct snd_soc_dapm_route q6afe_dapm_routes[] = {
 	{"TX_CODEC_DMA_TX_5", NULL, "TX_CODEC_DMA_TX_5 Capture"},
 	{"RX_CODEC_DMA_RX_6 Playback", NULL, "RX_CODEC_DMA_RX_6"},
 	{"RX_CODEC_DMA_RX_7 Playback", NULL, "RX_CODEC_DMA_RX_7"},
+	{"Internal BT-SCO Playback", NULL, "INT_BT_SCO_RX"},
+	{"INT_BT_SCO_TX", NULL, "Internal BT-SCO Capture"},
+	{"VOICE_RECORD_RX", NULL, "Voice Record RX Capture"},
+	{"VOICE_RECORD_TX", NULL, "Voice Record TX Capture"},
+	{"Voice Playback TX Playback", NULL, "VOICE_PLAYBACK_TX"},
 };
 
 static int msm_dai_q6_dai_probe(struct snd_soc_dai *dai)
@@ -687,6 +717,14 @@ static const struct snd_soc_dai_ops q6tdm_ops = {
 	.hw_params		= q6tdm_hw_params,
 };
 
