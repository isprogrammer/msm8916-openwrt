+static int q6voice_session_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct q6voice *v = q6voice_from_kcontrol(kcontrol);
+	unsigned int val = ucontrol->value.enumerated.item[0];
