+	if (val >= ARRAY_SIZE(q6voice_session_texts))
+		return -EINVAL;
+	if (q6voice_get_session(v, Q6VOICE_PATH_VOICE) == val)
+		return 0;
+	ret = q6voice_set_session(v, Q6VOICE_PATH_VOICE, val);
+	return ret ? ret : 1;
