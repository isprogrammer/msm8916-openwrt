diff --git a/sound/soc/qcom/apq8016_sbc.c b/sound/soc/qcom/apq8016_sbc.c
index 3023cf1..479781b 100644
--- a/sound/soc/qcom/apq8016_sbc.c
+++ b/sound/soc/qcom/apq8016_sbc.c
@@ -252,6 +252,36 @@ static int msm8916_qdsp6_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	return 0;
 }
 
+/*
+ * Backends that are not MI2S (internal BT SCO, voice record/playback pseudo
+ * ports): no LPASS clocks or codec setup, 8 kHz mono like the voice path.
+ */
+static int msm8916_qdsp6_voice_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
+						  struct snd_pcm_hw_params *params)
+{
+	struct snd_interval *rate = hw_param_interval(params,
+					SNDRV_PCM_HW_PARAM_RATE);
+	struct snd_interval *channels = hw_param_interval(params,
+					SNDRV_PCM_HW_PARAM_CHANNELS);
+	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+
+	rate->min = rate->max = 8000;
+	channels->min = channels->max = 1;
+	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+
+	return 0;
+}
+
+static bool msm8916_qdsp6_is_mi2s(int id)
+{
+	switch (id) {
+	case PRIMARY_MI2S_RX ... QUATERNARY_MI2S_TX:
+		return true;
+	default:
+		return false;
+	}
+}
+
 static void msm8916_qdsp6_add_ops(struct snd_soc_card *card)
 {
 	struct snd_soc_dai_link *link;
@@ -261,11 +291,15 @@ static void msm8916_qdsp6_add_ops(struct snd_soc_card *card)
 	card->components = "qdsp6";
 
 	for_each_card_prelinks(card, i, link) {
-		if (link->no_pcm) {
-			link->init = msm8916_qdsp6_dai_init;
-			link->ops = &msm8916_qdsp6_be_ops;
-			link->be_hw_params_fixup = msm8916_qdsp6_be_hw_params_fixup;
+		if (!link->no_pcm)
+			continue;
+		if (!msm8916_qdsp6_is_mi2s(link->id)) {
+			link->be_hw_params_fixup = msm8916_qdsp6_voice_be_hw_params_fixup;
+			continue;
 		}
+		link->init = msm8916_qdsp6_dai_init;
+		link->ops = &msm8916_qdsp6_be_ops;
+		link->be_hw_params_fixup = msm8916_qdsp6_be_hw_params_fixup;
 	}
 }
 
