#!/bin/sh /etc/rc.common
# Call manager: connects modem calls to a BT headset and/or Asterisk phones
# (START 99: after mm_auto_answer, which it stops while it runs)

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get ufivoice.main.mode)" = "none" ] && return 0
	if [ "$(uci -q get ufivoice.main.manage_answer)" = "1" ] && [ -x /etc/init.d/mm_auto_answer ]; then
		/etc/init.d/mm_auto_answer stop 2>/dev/null
	fi
	procd_open_instance
	procd_set_param command /usr/bin/python3 -u /usr/sbin/ufi-voiced
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/voicectl stop >/dev/null 2>&1
	if [ "$(uci -q get ufivoice.main.manage_answer)" = "1" ] && [ -x /etc/init.d/mm_auto_answer ]; then
		/etc/init.d/mm_auto_answer enabled && /etc/init.d/mm_auto_answer start 2>/dev/null
	fi
}
