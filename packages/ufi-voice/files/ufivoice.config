config ufivoice 'main'
	# Run the AP-side IMS data service (imsdcm). The modem's IMS stack runs in
	# hybrid mode (EFS ims_hybrid_enable=1) and asks the AP for the IMS PDN.
	option volte '1'
	# netifd interface of the mobile data connection; imsdcm starts after it
	option wan_iface 'modem'
	# Restart imsdcm when IMS has no connection for this long (s, doubled up
	# to 1 h while that does not help, 0 = never)
	option ims_kick_after '180'
	# Where calls go: bt | asterisk | both | none
	option mode 'both'
	# DSP voice session used for the audio path: cs | volte | auto (volte
	# while IMS is registered, else cs)
	option session 'auto'
	# MAC address of the paired headset (hfp-ag connects to it)
	option bt_headset ''
	# Page a disconnected headset with a backoff from 60 s up to this (s,
	# 0 = never, the headset connects by itself). Each page blinds the Wi-Fi
	# station for seconds (shared 2.4 GHz radio); no pages during calls
	option bt_reconnect_max '900'
	# Phones rung for incoming calls (Asterisk Dial() string)
	option sip_ring 'PJSIP/100&PJSIP/101'
	# Answer incoming calls by itself after N seconds (0 = never)
	option autoanswer '0'
	# Stop the mm_auto_answer service while ufi-voiced runs
	option manage_answer '1'
	# Phone audio: rate of the in-call PCMs (48000 = 10 ms periods) and the
	# jitter buffer for audio from the phones (ms); bridge_debug '1' logs
	# voicebridge statistics every 5 s
	option pcm_rate '48000'
	option jitter_ms '40'
	# Phone audio: mute the DSP's mic input (the unused BT SCO port) so only
	# the phones' audio goes into the call
	option host_tx_mute '1'
	option ami_user 'ufivoice'
	option ami_secret ''
	option audiosocket_port '9092'
