#!/bin/sh /etc/rc.common
# AP-side IMS data connection service for the modem (QMI 770 over QRTR)

START=96
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get ufivoice.main.volte)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/python3 -u /usr/sbin/imsdcm
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
