#!/bin/sh /etc/rc.common
# Bluetooth Hands-Free Audio Gateway (call control for ufi-voiced)

START=97
STOP=10
USE_PROCD=1

start_service() {
	case "$(uci -q get ufivoice.main.mode)" in
		bt|both|"") ;;
		*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/hfp-ag
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
