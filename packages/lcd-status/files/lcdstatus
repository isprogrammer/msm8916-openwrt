config global 'main'
	option enabled '1'
	option refresh_s '5'
	option rotation '0'
	option fg 'FFFFFF'
	option bg '000000'
	option font_scale '1'
	option backlight_brightness '-1'

config line
	option label 'TIME'
	option source 'time'
	option color 'FFFFFF'

config line
	option label 'WAN'
	option source 'wan_ip'
	option color '00FF80'

config line
	option label 'WIFI'
	option source 'wifi_clients'
	option color '80C0FF'

config line
	option label 'LOAD'
	option source 'cpu_load'
	option color 'FFFFFF'
