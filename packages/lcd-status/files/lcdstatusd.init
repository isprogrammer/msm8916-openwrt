#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

unbind_fbcon() {
	for bind in /sys/class/vtconsole/vtcon*/bind; do
		[ -e "$bind" ] || continue
		name="$(dirname "$bind")/name"
		grep -qi 'frame buffer' "$name" 2>/dev/null || continue
		echo 0 > "$bind" 2>/dev/null
	done
}

rebind_fbcon() {
	for bind in /sys/class/vtconsole/vtcon*/bind; do
		[ -e "$bind" ] || continue
		name="$(dirname "$bind")/name"
		grep -qi 'frame buffer' "$name" 2>/dev/null || continue
		echo 1 > "$bind" 2>/dev/null
	done
}

apply_panel_orientation_shell() {
	# Preserve the current console image where possible. This panel is RGB565,
	# 128x128 with a 32768-byte frame.
	frame="$(mktemp /tmp/lcdstatus-frame.XXXXXX)" || {
		logger -t lcdstatusd "cannot create temporary framebuffer image"
		return 1
	}
	if ! dd if=/dev/fb0 of="$frame" bs=32768 count=1 2>/dev/null ||
	   [ "$(wc -c < "$frame")" -ne 32768 ]; then
		logger -t lcdstatusd "could not read a full framebuffer image; using a blank frame"
		dd if=/dev/zero of="$frame" bs=32768 count=1 2>/dev/null
	fi
	printf '36 E8\n' > /sys/kernel/debug/dri/0/command 2>/dev/null ||
		logger -t lcdstatusd "panel E8 command returned nonzero (accepted by this panel)"
	dd if="$frame" of=/dev/fb0 bs=32768 count=1 2>/dev/null ||
		logger -t lcdstatusd "frame write after E8 failed"
	printf '36 C8\n' > /sys/kernel/debug/dri/0/command 2>/dev/null ||
		logger -t lcdstatusd "panel C8 command returned nonzero (accepted by this panel)"
	dd if="$frame" of=/dev/fb0 bs=32768 count=1 2>/dev/null ||
		logger -t lcdstatusd "frame write after C8 failed"
	rm -f "$frame"
}
start_service() {
	[ "$(uci -q get lcdstatus.main.enabled)" = "1" ] || {
		# Keep fbcon bound when the renderer is disabled, but initialize the
		# panel orientation once at boot so the console remains readable.
		apply_panel_orientation_shell
		return 0
	}
	unbind_fbcon
	procd_open_instance
	procd_set_param command /usr/sbin/lcdstatusd
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
stop_service() {
	# rc.common calls this before procd_kill; defer fbcon work until
	# service_stopped, which runs after procd has removed the daemon.
	:
}

service_stopped() {
	while pidof lcdstatusd >/dev/null 2>&1; do sleep 1; done
	rebind_fbcon
	# fbcon can reset the panel orientation when it binds again.
	apply_panel_orientation_shell
}
