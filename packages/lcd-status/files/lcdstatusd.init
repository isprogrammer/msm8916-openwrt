#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

unbind_fbcon() {
	for bind in /sys/class/vtconsole/vtcon*/bind; do
		[ -e "$bind" ] || continue
		name="$(dirname "$bind")/name"
		grep -qi 'frame buffer' "$name" 2>/dev/null || continue
		echo 0 > "$bind" 2>/dev/null
	done
}

rebind_fbcon() {
	for bind in /sys/class/vtconsole/vtcon*/bind; do
		[ -e "$bind" ] || continue
		name="$(dirname "$bind")/name"
		grep -qi 'frame buffer' "$name" 2>/dev/null || continue
		echo 1 > "$bind" 2>/dev/null
	done
}

start_service() {
	unbind_fbcon
	# The panel orientation command sequence must run on every boot, even if
	# lcdstatus itself is disabled. A return value of 1 from debugfs is normal.
	/usr/sbin/lcdstatusd --orientation-only >/dev/null 2>&1 || logger -t lcdstatusd "panel orientation sequence reported an error"
	[ "$(uci -q get lcdstatus.main.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/lcdstatusd
	procd_set_param env LCDSTATUS_ORIENTATION_DONE=1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	rebind_fbcon
}
