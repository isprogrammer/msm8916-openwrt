#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

unbind_fbcon() {
	for bind in /sys/class/vtconsole/vtcon*/bind; do
		[ -e "$bind" ] || continue
		name="$(dirname "$bind")/name"
		grep -qi 'frame buffer' "$name" 2>/dev/null || continue
		echo 0 > "$bind" 2>/dev/null
	done
}

rebind_fbcon() {
	for bind in /sys/class/vtconsole/vtcon*/bind; do
		[ -e "$bind" ] || continue
		name="$(dirname "$bind")/name"
		grep -qi 'frame buffer' "$name" 2>/dev/null || continue
		echo 1 > "$bind" 2>/dev/null
	done
}

service_triggers() {
	procd_add_reload_trigger "lcdstatus"
}

start_service() {
	rm -f /var/run/lcdstatus.poweroff /var/run/lcdstatus.shutdown
	[ "$(uci -q get lcdstatus.main.enabled)" = "1" ] || return 0
	unbind_fbcon
	procd_open_instance
	procd_set_param command /usr/sbin/lcdstatusd
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/lcdstatus
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
LCDSTATUS_SHUTDOWN_MODE=

stop_service() {
	case "${PROCD_SHUTDOWN_EVENT:-}" in
		reboot|poweroff) LCDSTATUS_SHUTDOWN_MODE="$PROCD_SHUTDOWN_EVENT" ;;
		halt) LCDSTATUS_SHUTDOWN_MODE=poweroff ;;
		*) return 0 ;;
	esac

	# Defer the final frame until procd has stopped lcdstatusd. This mirrors
	# the known-working button path and prevents a status refresh overwriting it.
	touch /var/run/lcdstatus.shutdown
	logger -t lcdstatusd "shutdown display queued: $LCDSTATUS_SHUTDOWN_MODE"
}

service_stopped() {
	if [ -e /var/run/lcdstatus.shutdown ]; then
		if [ -n "${LCDSTATUS_SHUTDOWN_MODE:-}" ]; then
			if [ -x /usr/sbin/jz08c-power-ui ]; then
				/usr/sbin/jz08c-power-ui "--$LCDSTATUS_SHUTDOWN_MODE" ||
					logger -t lcdstatusd "shutdown display failed: $LCDSTATUS_SHUTDOWN_MODE"
			else
				logger -t lcdstatusd "JZ08C shutdown display helper is unavailable"
			fi
		fi
		logger -t lcdstatusd "shutdown display active; leaving fb0 and fbcon untouched"
		return 0
	fi
	i=0
	while pgrep -f '^/usr/sbin/lcdstatusd' >/dev/null 2>&1; do
		[ "$i" -lt 5 ] || {
			logger -t lcdstatusd "timed out waiting for daemon to exit; leaving fbcon unbound"
			return 0
		}
		sleep 1
		i=$((i + 1))
	done
	rebind_fbcon
}
